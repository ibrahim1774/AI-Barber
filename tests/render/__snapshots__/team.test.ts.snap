  font-style: italic;
  color: var(--eu-ink-muted);
  font-size: 14px;
  letter-spacing: 0.06em;
  min-width: 40px;
}
.euphoria-root .eu-gallery-mosaic {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
}
@media (max-width: 767px) {
  .euphoria-root .eu-gallery-mosaic { grid-template-columns: repeat(2, 1fr); }
}

