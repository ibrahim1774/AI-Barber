}
.euphoria-root h1, .euphoria-root h2, .euphoria-root h3 {
  font-family: 'Newsreader', Georgia, serif;
  font-weight: 500;
  letter-spacing: -0.01em;
}
.euphoria-root .eu-eyebrow {
  font-family: 'Inter', sans-serif;
  text-transform: uppercase;
