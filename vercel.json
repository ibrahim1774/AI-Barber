{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/stripe-return",
      "destination": "/stripe-return.html"
    },
    {
      "source": "/stripe-return/",
      "destination": "/stripe-return.html"
    },
    {
      "source": "/book/(.*)",
      "destination": "/book.html"
    },
    {
      "source": "/shop/(.*)",
      "destination": "/shop.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/publish-sweeper",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ios/sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/book/reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/book/daily-summary",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/ios/publish.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/site.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/apple-notification.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/shop/setup.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/shop/plan.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/sweep.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/publish-sweeper.ts": {
      "maxDuration": 300
    },
    "api/admin/sites.ts": {
      "maxDuration": 300
    },
    "api/ios/domain/claim.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/domain/status.ts": {
      "includeFiles": "lib/ios/certs/**"
    }
  }
}
