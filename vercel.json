{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/publish-sweeper",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ios/sweep",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/ios/publish.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/site.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/apple-notification.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/sweep.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/publish-sweeper.ts": {
      "maxDuration": 300
    }
  }
}
