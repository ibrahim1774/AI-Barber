{
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/support/",
      "destination": "/support.html"
    },
    {
      "source": "/stripe-return",
      "destination": "/stripe-return.html"
    },
    {
      "source": "/stripe-return/",
      "destination": "/stripe-return.html"
    },
    {
      "source": "/book/(.*)",
      "destination": "/_ab/book.html"
    },
    {
      "source": "/shop/(.*)",
      "destination": "/_ab/shop.html"
    },
    {
      "source": "/((?!api/|_ab/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_ab/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/publish-sweeper",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ios/sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/book/reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/ios/domain-sweep",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/ios/publish.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/transfer.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/take-offline.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/delete-account.ts": {
      "maxDuration": 300
    },
    "api/ios/claim-start.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/site.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/apple-notification.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/shop/setup.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/shop/plan.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/sweep.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/publish-sweeper.ts": {
      "maxDuration": 300
    },
    "api/admin/sites.ts": {
      "maxDuration": 300
    },
    "api/ios/domain/claim.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/domain/status.ts": {
      "includeFiles": "lib/ios/certs/**"
    },
    "api/ios/domain-sweep.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/purchase-domain.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/stripe-webhook.ts": {
      "maxDuration": 300,
      "includeFiles": "lib/ios/certs/**"
    },
    "api/deploy-site.ts": {
      "maxDuration": 300
    }
  }
}
